# 依赖
node_modules/
RNApp/node_modules/

# Expo 构建缓存
.expo/
dist/
RNApp/dist/

# 原生构建生成目录（prebuild 产物，本地构建可复用但不入库）
RNApp/android/

# 构建产物 APK（保留于 artifacts/ 但不入库，避免大二进制）
*.apk

# 环境变量 / 密钥（绝不入库）
.env
.env.*
*.local

# 系统 / 编辑器
.DS_Store
*.log

# 旧版封存件（迁移自旧模板的 *.<名称>.旧版-YYYY-MM-DD，原件留工作区备查，不入库避免与新版模板混淆）
*.旧版-*

# 临时交付目录（转交材料用，工作完成即清，不入库）
/temp/

# ORCA 迁移备份（回滚用，勿入库）
*.旧版-2026-09-29

